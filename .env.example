# Copy to .env.local for local development. In Vercel: Project Settings > Environment Variables.
# Never commit real values. The Sanity project ID is pinned in sanity/env.ts (not an env var).

# --- Site
# Canonical origin (no trailing slash). Used for canonical URLs, sitemap, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.valenciasmileexpert.com

# --- Form leads (required in production)
# GoHighLevel inbound webhook URL. Leads are POSTed here as JSON (see lib/lead.ts).
GHL_WEBHOOK_URL=
# Optional second destination: email through Resend (resend.com)
RESEND_API_KEY=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=
# Optional Cloudflare Turnstile (bot protection). Empty = honeypot + time trap only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Sanity
# Editor token for `npm run seed` (never needed by the running site, never set in Vercel)
SANITY_WRITE_TOKEN=
# Shared secret for the publish webhook at /api/revalidate (same value in Sanity > API > Webhooks)
SANITY_REVALIDATE_SECRET=
# Read token: only needed if the dataset is made private
SANITY_READ_TOKEN=

# --- Tracking
# Google Tag Manager container (loaded after first interaction or idle). Empty = not loaded.
NEXT_PUBLIC_GTM_ID=GTM-PPV3TDK8
