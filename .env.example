# Copy to .env.local for local development. In Vercel: Project Settings > Environment Variables.
# Never commit real values. The Sanity project ID is pinned in sanity/env.ts (not an env var).

# --- Site
# Canonical origin (no trailing slash). Used for canonical URLs, sitemap, Open Graph and JSON-LD.
# The old domain (https://www.valenciasmileexpert.com) can be set here until the new one is live.
NEXT_PUBLIC_SITE_URL=https://valenciadentistryca.com

# --- Form leads
# Every lead is POSTed to TTR OS (portal.ttrdigitalmarketing.com/api/site/form), no setup needed.
# Optional override of the TTR OS site key (defaults to the public tracker key in lib/ttr-os.ts).
TTR_SITE_KEY=
# Optional legacy GoHighLevel inbound webhook (unused unless set). Leads are POSTed here as JSON.
GHL_WEBHOOK_URL=
# Optional second destination: email through Resend (resend.com)
RESEND_API_KEY=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=
# Optional Cloudflare Turnstile (bot protection). Empty = honeypot + time trap only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Sanity
# Editor token for `npm run seed` (never needed by the running site, never set in Vercel)
SANITY_WRITE_TOKEN=
# Shared secret for the publish webhook at /api/revalidate (same value in Sanity > API > Webhooks)
SANITY_REVALIDATE_SECRET=
# Viewer token: used only in draft preview (/api/preview) to read unpublished changes. Visitors never use it.
# Set in Vercel by TTR OS's bootstrap from the site connection's Viewer token.
SANITY_READ_TOKEN=
# Draft preview links from TTR OS: sig = HMAC-SHA256(PREVIEW_SECRET, "<path>\n<exp>") (lib/preview.ts).
# Generated and set in Vercel by TTR OS's bootstrap; empty = preview off.
PREVIEW_SECRET=

# --- Tracking
# Google Tag Manager container (loaded after first interaction or idle). Empty = not loaded.
NEXT_PUBLIC_GTM_ID=GTM-PPV3TDK8
